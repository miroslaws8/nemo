# Copy to .env (git-ignored): cp .env.example .env. Only QA_* keys reach the tests; QA_CONSOLE_*
# are the QA console's settings and never reach them. A variable set in the shell wins.
# docs/guide.md → Configuration, Console settings.

# --- The tests ---------------------------------------------------------------------------------
# The demo (pnpm demo) needs nothing here: a public site, tested signed out.

# The QA account of each environment that signs in, by its `credentials` name in e2e.config.yaml.
# Use a dedicated test account, never a personal one.
# QA_STAGE_EMAIL=qa@example.com
# QA_STAGE_PASSWORD=
# QA_PROD_EMAIL=qa@example.com
# QA_PROD_PASSWORD=

# Override an environment's hosts on this machine (QA_<NAME>_URL / _API / _ALIAS).
# QA_STAGE_URL=https://qa.staging.example.com
# QA_STAGE_API=https://api.staging.example.com

# --- The QA console (pnpm console) -------------------------------------------------------------
# Agent checks: a model key (one is enough) and the Hermes Agent command.
# QA_CONSOLE_ANTHROPIC_API_KEY=
# QA_CONSOLE_OPENAI_API_KEY=
# QA_CONSOLE_HERMES=hermes
# QA_CONSOLE_AGENT_DAILY_USD=5

# The CI tab (Bitbucket Pipelines): the repository as <workspace>/<repository> and a token that
# may read and run its pipelines.
# QA_CONSOLE_BITBUCKET_REPOSITORY=
# QA_CONSOLE_BITBUCKET_TOKEN=

# The skill store: an S3 bucket every console shares (docs/guide.md → Skill store).
# QA_CONSOLE_SKILLS_BUCKET=
# QA_CONSOLE_SKILLS_ACCESS_KEY_ID=
# QA_CONSOLE_SKILLS_SECRET_ACCESS_KEY=
# QA_CONSOLE_SKILLS_ENDPOINT=https://s3.amazonaws.com

# Server mode (the team's console) takes more: QA_CONSOLE_MODE=server, _PUBLIC_URL, _IDP_URL,
# _IDP_API_URL, _OAUTH_CLIENT_ID, _USERS_FILE, _GIT_URL — see console/deploy/README.md.
